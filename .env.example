# Flask session secret (use a long random string in production)
MINDWATCH_SECRET_KEY=mindwatch-development-secret-key

# SQLite database file (defaults to ./mindwatch.db next to app.py)
# MINDWATCH_DB_FILE=

# Timezone used for displayed timestamps (default: Asia/Kolkata)
# MINDWATCH_TZ=Asia/Kolkata

# Optional: enable LLM-based text analysis (leave blank to use local analyzer)
# MINDWATCH_LLM_API_KEY=sk-...
# MINDWATCH_LLM_URL=https://api.openai.com/v1/chat/completions
# MINDWATCH_LLM_MODEL=gpt-3.5-turbo
